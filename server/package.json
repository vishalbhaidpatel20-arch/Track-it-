{
  "name": "delivery-tracking-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/seed.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "db:start": "node scripts/db-start.js",
    "db:info": "node scripts/db-info.js",
    "db:backup": "node scripts/db-backup.js",
    "db:restore": "node scripts/db-restore.js",
    "db:reset": "node scripts/db-reset.js",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:api": "node --test --test-concurrency=1 \"test/api/*.test.js\""
  },
  "dependencies": {
    "@sentry/node": "^11.9.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
